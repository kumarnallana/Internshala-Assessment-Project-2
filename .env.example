# --- Gmail Credentials (SMTP) ---
GMAIL_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# --- Run Configuration ---
SEARCH_KEYWORD=Singing Bowls
DAILY_SEND_LIMIT=100
PRESENTATION_PATH=assets/demo_presentation.pdf

# --- AI Model APIs (OpenAI ChatGPT or Gemini) ---
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# --- Dry Run Mode ---
# If set to true, it validates recipients, creates MIME messages, attaches PDF, and logs "would send"
# but does NOT connect/send through Gmail.
DRY_RUN=true
